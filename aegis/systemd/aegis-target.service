[Unit]
Description=AEGIS vulnerable training HTTP target
After=aegis-target-broker.service
Requires=aegis-target-broker.service
[Service]
User=aegis-target
Group=aegis-target
ExecStart=/usr/bin/python3 /opt/defense-agent/vulnerable_app.py http
Restart=always
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=96M
[Install]
WantedBy=multi-user.target
